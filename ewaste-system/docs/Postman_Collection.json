{
  "info": {
    "name": "CirculAI Public API",
    "description": "Database-free public E-Waste Monitoring API. No authentication required.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "AI Model Information",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/ai/model-info",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ai",
            "model-info"
          ]
        }
      }
    },
    {
      "name": "AI Image Prediction",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": ""
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/ai/predict",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "ai",
            "predict"
          ]
        }
      }
    },
    {
      "name": "Environmental Analytics (empty in database-free mode)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/analytics/environmental",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "analytics",
            "environmental"
          ]
        }
      }
    }
  ]
}